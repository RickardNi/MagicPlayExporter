@inherits LayoutComponentBase

<MudLayout>
<MudAppBar Elevation="1" Style="background-color: #1c8e55;">
        <MudIconButton Icon="@Icons.Material.Filled.Casino" Color="Color.Inherit" Edge="Edge.Start" />
        <MudText Typo="Typo.h6">Magic Play Exporter</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>