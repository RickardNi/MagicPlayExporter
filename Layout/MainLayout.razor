@inherits LayoutComponentBase
@using MagicPlayExporter.Components
@using MagicPlayExporter.Services
@using MagicPlayExporter.Models
@inject IDialogService DialogService
@inject ISettingsStorage SettingsStorage

<MudLayout>
<MudAppBar Elevation="1" Style="background-color: #1c8e55;">
        <MudIconButton Color="Color.Inherit" Edge="Edge.Start" Class="mr-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers-icon lucide-layers"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg>
        </MudIconButton>
        <MudText Typo="Typo.h6">Magic Play Exporter</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Upload" 
                       Color="Color.Inherit" 
                       OnClick="OpenBgStatsImportDialog"
                       title="Import BGStats Data" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private async Task OpenBgStatsImportDialog()
    {
        // Check if there's any actual data in the form
        var savedFormData = await SettingsStorage.GetSettingAsync<FormData>(LocalStorageSettings.FormData);
        if (savedFormData != null && HasAnyRowData(savedFormData.GameplayRows))
        {
            await DialogService.ShowMessageBox(
                "Form Contains Data",
                "Please clear or export your current form data before importing new data.",
                yesText: "OK");
            return;
        }

        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseOnEscapeKey = true,
            CloseButton = true,
        };

        var dialog = await DialogService.ShowAsync<BgStatsImportDialog>("Import BGStats Data", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            // Trigger a page refresh by navigating to the same page
            // This will cause Home.razor to reload and fetch fresh data
            await Task.Delay(100); // Small delay to ensure storage is updated
            StateHasChanged();
        }
    }

    private bool HasAnyRowData(List<GameplayRowData> rows)
    {
        return rows.Any(row => 
            row.Player1Id.HasValue
            || row.Player2Id.HasValue
            || row.StartTime.HasValue
            || row.EndTime.HasValue
            || !string.IsNullOrWhiteSpace(row.Player1Deck)
            || !string.IsNullOrWhiteSpace(row.Player2Deck)
            || !string.IsNullOrWhiteSpace(row.Winner)
            || !string.IsNullOrWhiteSpace(row.StartingPlayer)
            || row.P1Colors.Count > 0
            || row.P2Colors.Count > 0);
    }
}