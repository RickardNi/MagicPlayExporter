@page "/"
@inject ISettingsStorage SettingsStorage
@inject IDialogService DialogService

<PageTitle>Magic Play Exporter</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="2">
            <MudDatePicker Label="Date" @bind-Date="playDate" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" sm="2">
            <MudSelect T="string" Label="Format" @bind-Value="selectedFormat" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                <MudSelectItem Value="@("BattleDecks")">Battle Decks</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudSelect T="string" Label="Set" @bind-Value="selectedSet" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(selectedFormat != "Draft")">
                <MudSelectItem Value="@("Magic Foundations")">Magic Foundations</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="5">
            <MudSelect T="string" Label="Draft Type" @bind-Value="selectedDraftType" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(selectedFormat != "Draft")">
                <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                <MudSelectItem Value="@("Pick-Two")">Pick-Two</MudSelectItem>
                <MudSelectItem Value="@("Grid")">Grid</MudSelectItem>
                <MudSelectItem Value="@("Winston")">Winston</MudSelectItem>
                <MudSelectItem Value="@("Winchester")">Winchester</MudSelectItem>
                <MudSelectItem Value="@("Minneapolis")">Minneapolis</MudSelectItem>
                <MudSelectItem Value="@("Sealed")">Sealed</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="Players">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudList T="string" Dense="true">
                    @foreach (var player in playerList)
                    {
                        <MudListItem Text="@player.Name" Icon="@Icons.Material.Filled.Person" />
                    }
                </MudList>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Import Players</MudText>
                <MudTextField T="string"
                              Label="JSON Content"
                              @bind-Value="playersJsonImport"
                              Variant="Variant.Outlined"
                              Lines="5"
                              Class="mb-2" />
                <div class="d-flex align-center gap-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileUpload"
                               OnClick="ImportPlayers">
                        Import
                    </MudButton>
                    @if (!string.IsNullOrEmpty(importMessage))
                    {
                        <MudText Color="@importMessageColor" Typo="Typo.body2">@importMessage</MudText>
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudPaper Class="pa-4 mb-4">
<div class="d-flex justify-start mb-4 gap-2">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AddRow">
        Add
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               StartIcon="@Icons.Material.Filled.IosShare"
               OnClick="ExportData">
        Export
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               StartIcon="@Icons.Material.Filled.Delete"
               OnClick="ClearAllData">
        Clear all data
    </MudButton>
</div>

    <!-- Header Row -->
    <MudGrid Class="mb-2" Spacing="0">
        <MudItem xs="12" Class="d-flex align-center">
            <div class="line-number px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">#</MudText>
            </div>
            <div class="time-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Start</MudText>
            </div>
            <div class="time-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">End</MudText>
            </div>
            <div class="duration-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Duration</MudText>
            </div>
            @RenderPlayerHeader()
            @RenderPlayerHeader()
        </MudItem>
    </MudGrid>

    <MudDivider Class="mb-4" />

    <!-- Data Entry Rows -->
    @for (int i = 0; i < gameplayRows.Count; i++)
    {
        int rowIndex = i;
        var row = gameplayRows[rowIndex];

        <MudGrid @key="row" Class="mb-3" Spacing="0">
            <MudItem xs="12" Class="d-flex align-center">
                <div class="line-number px-1">
                    <MudText Typo="Typo.body2" Class="text-muted">@(rowIndex + 1)</MudText>
                </div>

                <div class="time-col px-1">
                    <MudTextField T="TimeSpan?"
                                   @bind-Value="row.StartTime"
                                   InputType="InputType.Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @onblur="@(() => { OnStartTimeBlur(row); MarkFormDirty(); })" />
                </div>

                <div class="time-col px-1">
                    <MudTextField T="TimeSpan?"
                                   @bind-Value="row.EndTime"
                                   InputType="InputType.Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @onblur="@(() => MarkFormDirty())" />
                </div>

                <div class="duration-col px-1">
                    <MudText Typo="Typo.body2">@(row.GameTimeMinutes > 0 ? row.GameTimeMinutes.ToString() : "-")</MudText>
                </div>

                @RenderPlayerEntry(row, "P1")
                @RenderPlayerEntry(row, "P2")

                <div class="delete-col px-1">
                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   OnClick="@(() => RemoveRow(row))" />
                </div>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private RenderFragment RenderPlayerHeader() => __builder =>
    {
        <div class="winner-col d-flex justify-center">
        </div>
        <div class="start-col d-flex justify-center">
        </div>
        <div class="name-col px-1">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Name</MudText>
        </div>
        <div class="colors-col px-1">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                @(selectedFormat == "BattleDecks" ? "Deck" : "Colors")
            </MudText>
        </div>
        <div class="delete-col"></div>
    };

    private RenderFragment RenderPlayerEntry(GameplayRow row, string playerKey) => __builder =>
    {
        var isP1 = playerKey == "P1";
        var playerName = isP1 ? row.Player1 : row.Player2;
        var playerDeck = isP1 ? row.Player1Deck : row.Player2Deck;
        var colors = isP1 ? row.P1Colors : row.P2Colors;
        var isWinner = row.Winner == playerKey;

        <div class="winner-col d-flex justify-center">
            <div class="@($"winner-crown-btn {(isWinner ? "selected" : "not-selected")}")"
                 @onclick="@(() => { row.Winner = playerKey; MarkFormDirty(); })">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown-icon lucide-crown"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/></svg>
            </div>
        </div>
        <div class="start-col d-flex justify-center">
            <div class="@($"start-player-btn {(row.StartingPlayer == playerKey ? "selected" : "not-selected")}")"
                 @onclick="@(() => { row.StartingPlayer = playerKey; MarkFormDirty(); })">
                1
            </div>
        </div>
        <div class="@($"name-col px-1 player-container {(isWinner ? "player-winner-bg" : "")}")">
            <MudAutocomplete T="string"
                             Value="isP1 ? row.Player1 : row.Player2"
                             ValueChanged="@(v => { if(isP1) row.Player1 = v; else row.Player2 = v; MarkFormDirty(); })"
                             Label="@(isP1 ? "Player 1" : "Player 2")"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             SearchFunc="@SearchPlayers" />
        </div>
        <div class="@($"colors-col px-1 player-container {(isWinner ? "player-winner-bg" : "")}")">
            @if (selectedFormat == "Draft")
            {
                <MudStack Row="true" Spacing="0">
                    @foreach (var key in ColorKeys)
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Variant="Variant.Text"
                                 OnClick="@(() => ToggleColor(colors, key))"
                                 Size="Size.Small"
                                 Class="color-chip"
                                 Ripple="false"
                                 Style="@GetColorChipStyle(colors.Contains(key))">
                            @RenderManaIcon(key)
                        </MudChip>
                    }
                </MudStack>
            }
            else
            {
                <MudAutocomplete T="string"
                                 Value="isP1 ? row.Player1Deck : row.Player2Deck"
                                 ValueChanged="@(v => { if(isP1) row.Player1Deck = v; else row.Player2Deck = v; MarkFormDirty(); })"
                                 Label="Deck"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchDecks" />
            }
        </div>
    };

