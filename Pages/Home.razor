@page "/"
@using MagicPlayExporter.Models
@using MagicPlayExporter.Models.Import
@using MagicPlayExporter.Components
@using MagicPlayExporter.Services
@inject ISettingsStorage SettingsStorage
@inject IDialogService DialogService
@inject DataImportNotificationService NotificationService
@implements IDisposable

<PageTitle>Magic Play Exporter</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="2">
            <MudDatePicker Label="Date" @bind-Date="playDate" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" sm="2">
            <MudSelect T="string" Label="Format" @bind-Value="selectedFormat" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                <MudSelectItem Value="@("BattleDecks")">Battle Decks</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudSelect T="string" Label="Set" @bind-Value="selectedSet" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(selectedFormat != "Draft")">
                @foreach (var set in availableSets)
                {
                    <MudSelectItem Value="@set">@set</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="5">
            <MudSelect T="string" Label="Draft Type" @bind-Value="selectedDraftType" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(selectedFormat != "Draft")">
                @foreach (var draftType in availableDraftTypes)
                {
                    <MudSelectItem Value="@draftType">@draftType</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudExpansionPanels Class="mb-4">
    <PlayerManagementPanel PlayerList="@playerList"
                           GameplayRows="@gameplayRows"
                           OnPlayersChanged="@OnPlayersImported" />
</MudExpansionPanels>

<MudPaper Class="pa-4 mb-4">
    <div class="d-flex justify-start mb-4 gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddRow">
            Add
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.IosShare"
                   OnClick="ExportData">
            Export
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="ClearAllData">
            Clear all data
        </MudButton>
    </div>

    <!-- Header Row -->
    <MudGrid Class="mb-2" Spacing="0">
        <MudItem xs="12" Class="d-flex align-center">
            <div class="line-number px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">#</MudText>
            </div>
            <div class="time-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Start</MudText>
            </div>
            <div class="time-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">End</MudText>
            </div>
            <div class="duration-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Duration</MudText>
            </div>
            @RenderPlayerHeader()
            @RenderPlayerHeader()
            <div class="delete-col"></div>
        </MudItem>
    </MudGrid>

    <MudDivider Class="mb-4" />

    <!-- Data Entry Rows -->
    @for (int i = 0; i < gameplayRows.Count; i++)
    {
        int rowIndex = i;
        var row = gameplayRows[rowIndex];

        <MudGrid @key="row" Class="mb-3" Spacing="0">
            <MudItem xs="12" Class="d-flex align-center">
                <div class="line-number px-1">
                    <MudText Typo="Typo.body2" Class="text-muted">@(rowIndex + 1)</MudText>
                </div>

                <div class="time-col px-1">
                    <MudTextField T="TimeSpan?"
                                   @bind-Value="row.StartTime"
                                   InputType="InputType.Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @onblur="@(() => { OnStartTimeBlur(row); MarkFormDirty(); })" />
                </div>

                <div class="time-col px-1">
                    <MudTextField T="TimeSpan?"
                                   @bind-Value="row.EndTime"
                                   InputType="InputType.Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @onblur="@(() => MarkFormDirty())" />
                </div>

                <div class="duration-col px-1">
                    <MudText Typo="Typo.body2">@(row.GameTimeMinutes > 0 ? row.GameTimeMinutes.ToString() : "-")</MudText>
                </div>

                <PlayerEntry PlayerName="@row.Player1"
                             Label="Player 1"
                             DeckName="@row.Player1Deck"
                             Colors="@row.P1Colors"
                             IsWinner="@(row.Winner == "P1")"
                             IsStartingPlayer="@(row.StartingPlayer == "P1")"
                             Format="@selectedFormat"
                             OnWinnerClick="@(() => { row.Winner = "P1"; MarkFormDirty(); })"
                             OnStartingPlayerClick="@(() => { row.StartingPlayer = "P1"; MarkFormDirty(); })"
                             OnPlayerNameChanged="@(v => { OnPlayerNameChanged(row, true, v); MarkFormDirty(); })"
                             OnDeckChanged="@(v => { row.Player1Deck = v; MarkFormDirty(); })"
                             OnColorClick="@(EventCallback.Factory.Create<string>(this, color => ToggleColorForPlayer(row.Player1, color)))"
                             SearchPlayers="@SearchPlayers"
                             SearchDecks="@SearchDecks" />

                <PlayerEntry PlayerName="@row.Player2"
                             Label="Player 2"
                             DeckName="@row.Player2Deck"
                             Colors="@row.P2Colors"
                             IsWinner="@(row.Winner == "P2")"
                             IsStartingPlayer="@(row.StartingPlayer == "P2")"
                             Format="@selectedFormat"
                             OnWinnerClick="@(() => { row.Winner = "P2"; MarkFormDirty(); })"
                             OnStartingPlayerClick="@(() => { row.StartingPlayer = "P2"; MarkFormDirty(); })"
                             OnPlayerNameChanged="@(v => { OnPlayerNameChanged(row, false, v); MarkFormDirty(); })"
                             OnDeckChanged="@(v => { row.Player2Deck = v; MarkFormDirty(); })"
                             OnColorClick="@(EventCallback.Factory.Create<string>(this, color => ToggleColorForPlayer(row.Player2, color)))"
                             SearchPlayers="@SearchPlayers"
                             SearchDecks="@SearchDecks" />

                <div class="delete-col px-1">
                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   OnClick="@(() => RemoveRow(row))" />
                </div>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private RenderFragment RenderPlayerHeader() => __builder =>
    {
        <div class="winner-col d-flex justify-center">
        </div>
        <div class="start-col d-flex justify-center">
        </div>
        <div class="name-col px-1">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Name</MudText>
        </div>
        <div class="colors-col px-1">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                @(selectedFormat == "BattleDecks" ? "Deck" : "Colors")
            </MudText>
        </div>
    };

    private DateTime? playDate = DateTime.Today;
    private string selectedFormat = "Draft";
    private string selectedSet = "Magic Foundations";
    private string selectedDraftType = "Draft";

    private List<Player> playerList = new();
    private bool isFormDirty = false;
    private Dictionary<string, HashSet<string>> playerColorsMap = new();

    private List<GameplayRow> gameplayRows = new();

    private List<string> availableDraftTypes = new List<string>
    {
        "Draft",
        "Pick-Two Draft",
        "Sealed",
        "Winston Draft",
        "Winchester Draft",
        "Grid Draft",
        "Minneapolis Draft"
    };

    private List<string> availableSets = new List<string>
    {
        "Magic Foundations Cube"
    };

    private void OnStartTimeBlur(GameplayRow row)
    {
        if (row.StartTime.HasValue && !row.EndTime.HasValue)
        {
            var end = row.StartTime.Value.Add(TimeSpan.FromMinutes(15));
            if (end.TotalDays >= 1) end = end.Subtract(TimeSpan.FromDays(1));
            row.EndTime = end;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NotificationService.DataImported += OnDataImported;

        await LoadPlayersFromStorageAsync();
        await LoadGameMetaDataFromStorageAsync();

        for (int i = 0; i < 12; ++i)
        {
            AddRow();
        }
    }

    private async void OnDataImported(object? sender, EventArgs e)
    {
        await LoadPlayersFromStorageAsync();
        await LoadGameMetaDataFromStorageAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotificationService.DataImported -= OnDataImported;
    }

    private async Task LoadPlayersFromStorageAsync()
    {
        var savedPlayers = await SettingsStorage.GetSettingAsync<List<Player>>(LocalStorageSettings.Players);
        if (savedPlayers != null && savedPlayers.Count > 0)
        {
            playerList = savedPlayers;
        }
    }

    private async Task LoadGameMetaDataFromStorageAsync()
    {
        var gameMetaData = await SettingsStorage.GetSettingAsync<GameMetaData>(LocalStorageSettings.GameMetaData);
        if (gameMetaData?.GameAddedBoards != null && gameMetaData.GameAddedBoards.Count > 0)
        {
            var predefinedDraftTypes = new List<string>
            {
                "Draft",
                "Pick-Two Draft",
                "Sealed",
                "Winston Draft",
                "Winchester Draft",
                "Grid Draft",
                "Minneapolis Draft"
            };

            var predefinedSets = new List<string>
            {
                "Magic Foundations Cube"
            };

            var importedDraftTypes = gameMetaData.GameAddedBoards
                .Where(board => predefinedDraftTypes.Contains(board))
                .ToList();

            var importedSets = gameMetaData.GameAddedBoards
                .Where(board => predefinedSets.Contains(board))
                .ToList();

            if (importedDraftTypes.Count > 0)
            {
                availableDraftTypes = predefinedDraftTypes
                    .Where(type => importedDraftTypes.Contains(type))
                    .ToList();

                if (availableDraftTypes.Count > 0)
                {
                    selectedDraftType = availableDraftTypes[0];
                }
            }

            if (importedSets.Count > 0)
            {
                availableSets = predefinedSets
                    .Where(set => importedSets.Contains(set))
                    .ToList();

                if (availableSets.Count > 0)
                {
                    selectedSet = availableSets[0];
                }
            }
        }
    }

    private void AddRow() => gameplayRows.Add(new GameplayRow());

    private async Task RemoveRow(GameplayRow row)
    {
        if (HasRowData(row))
        {
            bool? result = await DialogService.ShowMessageBox(
                "Remove Row",
                "This row contains data. Are you sure you want to remove it?",
                yesText: "Remove",
                cancelText: "Cancel");

            if (result != true)
            {
                return;
            }
        }

        gameplayRows.Remove(row);
        MarkFormDirty();
    }

    private bool HasRowData(GameplayRow row)
    {
        return !string.IsNullOrWhiteSpace(row.Player1)
            || !string.IsNullOrWhiteSpace(row.Player2)
            || row.StartTime.HasValue
            || row.EndTime.HasValue
            || !string.IsNullOrWhiteSpace(row.Player1Deck)
            || !string.IsNullOrWhiteSpace(row.Player2Deck)
            || !string.IsNullOrWhiteSpace(row.Winner)
            || !string.IsNullOrWhiteSpace(row.StartingPlayer)
            || row.P1Colors.Count > 0
            || row.P2Colors.Count > 0;
    }

    private void ExportData()
    {
        // TODO: Implement export logic
    }

    private void OnPlayerNameChanged(GameplayRow row, bool isP1, string newPlayerName)
    {
        if (isP1)
        {
            row.Player1 = newPlayerName;
        }
        else
        {
            row.Player2 = newPlayerName;
        }

        if (selectedFormat == "Draft" && !string.IsNullOrWhiteSpace(newPlayerName))
        {
            if (!playerColorsMap.ContainsKey(newPlayerName))
            {
                playerColorsMap[newPlayerName] = new HashSet<string>();
            }

            var targetColors = isP1 ? row.P1Colors : row.P2Colors;
            targetColors.Clear();
            foreach (var color in playerColorsMap[newPlayerName])
            {
                targetColors.Add(color);
            }
        }
    }

    private void ToggleColorForPlayer(string playerName, string color)
    {
        if (string.IsNullOrWhiteSpace(playerName) || selectedFormat != "Draft")
            return;

        if (!playerColorsMap.ContainsKey(playerName))
        {
            playerColorsMap[playerName] = new HashSet<string>();
        }

        if (playerColorsMap[playerName].Contains(color))
        {
            playerColorsMap[playerName].Remove(color);
        }
        else
        {
            playerColorsMap[playerName].Add(color);
        }

        foreach (var row in gameplayRows)
        {
            if (row.Player1 == playerName)
            {
                row.P1Colors.Clear();
                foreach (var c in playerColorsMap[playerName])
                {
                    row.P1Colors.Add(c);
                }
            }
            if (row.Player2 == playerName)
            {
                row.P2Colors.Clear();
                foreach (var c in playerColorsMap[playerName])
                {
                    row.P2Colors.Add(c);
                }
            }
        }

        MarkFormDirty();
        StateHasChanged();
    }

    private void OnPlayersImported(List<Player> players)
    {
        playerList = players;
        StateHasChanged();
    }

    private async Task<IEnumerable<string>> SearchPlayers(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        var playerNames = playerList.Select(p => p.Name).ToList();
        return string.IsNullOrEmpty(value) ? playerNames : playerNames.Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchDecks(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        var decks = new[] { "Adventure Time v1", "Converging Domains v6", "Imperious Elves v4", "Shock Troupes v6" };
        return string.IsNullOrEmpty(value) ? decks : decks.Where(d => d.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private void MarkFormDirty()
    {
        isFormDirty = true;
    }

    private async Task ClearAllData()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Clear All Data",
            "Are you sure you want to clear all data? This will remove all entries and cannot be undone.",
            yesText: "Clear",
            cancelText: "Cancel");

        if (result == true)
        {
            gameplayRows.Clear();
            playerColorsMap.Clear();
            for (int i = 0; i < 12; i++)
            {
                AddRow();
            }
            isFormDirty = false;
            StateHasChanged();
        }
    }
}
