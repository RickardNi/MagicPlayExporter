    private void ToggleColor(HashSet<string> colorSet, string color)
    {
        if (colorSet.Contains(color)) colorSet.Remove(color);
        else colorSet.Add(color);
        MarkFormDirty();
    }

    private string GetColorChipStyle(bool isSelected)
    {
        var opacity = isSelected ? "1.0" : "0.15";
        var shadow = isSelected ? "filter: drop-shadow(0px 2px 1px rgba(0,0,0,0.9));" : "";
        var border = isSelected ? "border: 1px solid rgba(0,0,0,0.7) !important;" : "border: 1px solid transparent !important;";
        return $"background-color: transparent !important; opacity: {opacity}; {shadow} {border}";
    }

    private async Task ImportPlayers()
    {
        importMessage = string.Empty;

        if (isFormDirty)
        {
            importMessage = "Cannot import players while there are unsaved changes in the form. Please export or clear your data first.";
            importMessageColor = Color.Error;
            return;
        }

        var json = (playersJsonImport ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(json))
        {
            importMessage = "Please paste JSON content first.";
            importMessageColor = Color.Error;
            return;
        }

        // Handle common copy-paste artifacts
        if (json.EndsWith(",")) json = json.TrimEnd(',').Trim();

        // If it looks like a property snippet "players": [...], wrap it in braces to make it valid JSON
        if (json.StartsWith("\"players\"") || json.StartsWith("players"))
        {
            json = "{" + json + "}";
        }

        try
        {
            var options = new JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true,
                AllowTrailingCommas = true,
                ReadCommentHandling = JsonCommentHandling.Skip
            };

            List<Player>? imported = null;

            using (JsonDocument doc = JsonDocument.Parse(json, new JsonDocumentOptions { AllowTrailingCommas = true, CommentHandling = JsonCommentHandling.Skip }))
            {
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    imported = JsonSerializer.Deserialize<List<Player>>(doc.RootElement.GetRawText(), options);
                }
                else if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    if (doc.RootElement.TryGetProperty("players", out var playersElement) && playersElement.ValueKind == JsonValueKind.Array)
                    {
                        imported = JsonSerializer.Deserialize<List<Player>>(playersElement.GetRawText(), options);
                    }
                }
            }

            if (imported != null)
            {
                playerList = imported;
                await SettingsStorage.SaveSettingAsync(LocalStorageSettings.Players, playerList);
                playersJsonImport = string.Empty;
                importMessage = $"Successfully imported {imported.Count} players.";
                importMessageColor = Color.Success;
                StateHasChanged();
            }
            else
            {
                importMessage = "Could not find a list of players in the JSON.";
                importMessageColor = Color.Error;
            }
        }
        catch (Exception ex)
        {
            importMessage = $"Import failed: {ex.Message}";
            importMessageColor = Color.Error;
        }
    }

    private async Task<IEnumerable<string>> SearchPlayers(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        var playerNames = playerList.Select(p => p.Name).ToList();
        return string.IsNullOrEmpty(value) ? playerNames : playerNames.Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchDecks(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        var decks = new[] { "Adventure Time v1", "Converging Domains v6", "Imperious Elves v4", "Shock Troupes v6" };
        return string.IsNullOrEmpty(value) ? decks : decks.Where(d => d.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private void MarkFormDirty()
    {
        isFormDirty = true;
    }

    private async Task ClearAllData()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Clear All Data",
            "Are you sure you want to clear all data? This will remove all entries and cannot be undone.",
            yesText: "Clear",
            cancelText: "Cancel");

        if (result == true)
        {
            gameplayRows.Clear();
            for (int i = 0; i < 12; i++)
            {
                AddRow();
            }
            isFormDirty = false;
            StateHasChanged();
        }
    }
