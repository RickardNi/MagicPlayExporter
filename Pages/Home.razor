@page "/"
@using MagicPlayExporter.Components

<PageTitle>Magic Play Exporter</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="2">
            <MudDatePicker Label="Date" 
                          Date="@playDate" 
                          DateChanged="@(async (DateTime? newDate) => { playDate = newDate; await SaveFormDataToStorageAsync(); })" 
                          DateFormat="yyyy-MM-dd" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" sm="2">
            <MudSelect T="string" 
                       Label="Format" 
                       Value="@selectedFormat" 
                       ValueChanged="@OnFormatChanged" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                <MudSelectItem Value="@("BattleDecks")">Battle Decks</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudSelect T="string" 
                      Label="Set" 
                      Value="@selectedSet" 
                      ValueChanged="@(async (string newSet) => { selectedSet = newSet; await SaveFormDataToStorageAsync(); })" 
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Disabled="@(selectedFormat != "Draft")">
                @foreach (var set in availableSets)
                {
                    <MudSelectItem Value="@set">@set</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="5">
            <MudSelect T="string" 
                      Label="Draft Type" 
                      Value="@selectedDraftType" 
                      ValueChanged="@(async (string newDraftType) => { selectedDraftType = newDraftType; await SaveFormDataToStorageAsync(); })" 
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Disabled="@(selectedFormat != "Draft")">
                @foreach (var draftType in availableDraftTypes)
                {
                    <MudSelectItem Value="@draftType">@draftType</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudExpansionPanels Class="mb-4">
    <PlayerManagementPanel PlayerList="@playerList"
                           GameplayRows="@gameplayRows"
                           OnPlayersChanged="@OnPlayersImported" />
</MudExpansionPanels>

<MudPaper Class="pa-4 mb-4">
    <div class="d-flex justify-start mb-4 gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddRowAsync">
            Add
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.IosShare"
                   OnClick="ExportData">
            Export
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="ClearAllData">
            Clear all data
        </MudButton>
    </div>

    <!-- Header Row -->
    <MudGrid Class="mb-2" Spacing="0">
        <MudItem xs="12" Class="d-flex align-center">
            <div class="line-number px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">#</MudText>
            </div>
            <div class="time-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Start</MudText>
            </div>
            <div class="time-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">End</MudText>
            </div>
            <div class="duration-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Duration</MudText>
            </div>
            <div class="winner-col d-flex justify-center">
            </div>
            <div class="start-col d-flex justify-center">
            </div>
            <div class="name-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Name</MudText>
            </div>
            <div class="@($"colors-col px-1 {(selectedFormat == "BattleDecks" ? "deck-mode" : "")}")"> 
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                    @(selectedFormat == "BattleDecks" ? "Deck" : "Colors")
                </MudText>
            </div>
            <div class="winner-col d-flex justify-center">
            </div>
            <div class="start-col d-flex justify-center">
            </div>
            <div class="name-col px-1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Name</MudText>
            </div>
            <div class="@($"colors-col px-1 {(selectedFormat == "BattleDecks" ? "deck-mode" : "")}")"> 
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                    @(selectedFormat == "BattleDecks" ? "Deck" : "Colors")
                </MudText>
            </div>
            <div class="delete-col"></div>
        </MudItem>
    </MudGrid>

    <MudDivider Class="mb-4" />

    <!-- Data Entry Rows -->
    @for (int i = 0; i < gameplayRows.Count; i++)
    {
        int rowIndex = i;
        var row = gameplayRows[rowIndex];

        <MudGrid @key="row" Class="mb-3" Spacing="0">
            <MudItem xs="12" Class="d-flex align-center">
                <div class="line-number px-1">
                    <MudText Typo="Typo.body2" Class="text-muted">@(rowIndex + 1)</MudText>
                </div>

                <div class="time-col px-1">
                    <MudTextField T="TimeSpan?"
                                   @bind-Value="row.StartTime"
                                   InputType="InputType.Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @onfocus="@(() => OnStartTimeFocus(row, rowIndex))"
                                   @onblur="@(async () => { OnStartTimeBlur(row); await SaveFormDataToStorageAsync(); })" />
                </div>

                <div class="time-col px-1">
                    <MudTextField T="TimeSpan?"
                                   @bind-Value="row.EndTime"
                                   InputType="InputType.Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @onblur="@SaveFormDataToStorageAsync" />
                </div>

                <div class="duration-col px-1">
                    <MudText Typo="Typo.body2">@(row.GameTimeMinutes > 0 ? row.GameTimeMinutes.ToString() : "-")</MudText>
                </div>

                <PlayerEntry PlayerName="@row.Player1"
                             Label="Player 1"
                             DeckName="@ToDisplayDeckName(row.Player1Deck)"
                             Colors="@row.P1Colors"
                             IsWinner="@(row.Winner == "P1")"
                             IsStartingPlayer="@(row.StartingPlayer == "P1")"
                             Format="@selectedFormat"
                             OnWinnerClick="@(async () => { row.Winner = "P1"; await SaveFormDataToStorageAsync(); })"
                             OnStartingPlayerClick="@(async () => { row.StartingPlayer = "P1"; await SaveFormDataToStorageAsync(); })"
                             OnPlayerNameChanged="@(async v => { OnPlayerNameChanged(row, true, v); await SaveFormDataToStorageAsync(); })"
                             OnDeckChanged="@(async v => { row.Player1Deck = ToFullDeckName(v); await SaveFormDataToStorageAsync(); })"
                             OnColorClick="@(EventCallback.Factory.Create<string>(this, color => ToggleColorForPlayer(row.Player1, color)))"
                             SearchPlayers="@((value, token) => SearchPlayersForRow(value, token, row.Player2))"
                             SearchDecks="@SearchDecks"
                             OtherPlayerName="@row.Player2" />

                <PlayerEntry PlayerName="@row.Player2"
                             Label="Player 2"
                             DeckName="@row.Player2Deck"
                             Colors="@row.P2Colors"
                             IsWinner="@(row.Winner == "P2")"
                             IsStartingPlayer="@(row.StartingPlayer == "P2")"
                             Format="@selectedFormat"
                             OnWinnerClick="@(async () => { row.Winner = "P2"; await SaveFormDataToStorageAsync(); })"
                             OnStartingPlayerClick="@(async () => { row.StartingPlayer = "P2"; await SaveFormDataToStorageAsync(); })"
                             OnPlayerNameChanged="@(async v => { OnPlayerNameChanged(row, false, v); await SaveFormDataToStorageAsync(); })"
                             OnDeckChanged="@(async v => { row.Player2Deck = v; await SaveFormDataToStorageAsync(); })"
                             OnColorClick="@(EventCallback.Factory.Create<string>(this, color => ToggleColorForPlayer(row.Player2, color)))"
                             SearchPlayers="@((value, token) => SearchPlayersForRow(value, token, row.Player1))"
                             SearchDecks="@SearchDecks"
                             OtherPlayerName="@row.Player1" />

                <div class="delete-col px-1">
                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   OnClick="@(() => RemoveRow(row))" />
                </div>
            </MudItem>
        </MudGrid>
    }
</MudPaper>
